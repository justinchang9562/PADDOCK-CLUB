# 可选：提高上游赛车数据供应商的请求超时时间。
PADDOCK_DATA_TIMEOUT_MS=7000

# 可选：OpenF1 实时数据认证。仅服务端读取，绝不要添加 NEXT_PUBLIC_ 前缀。
# OpenF1 当前使用用户名/密码向 /token 换取短期 Bearer token。
OPENF1_USERNAME=
OPENF1_PASSWORD=
OPENF1_TIMEOUT_MS=5000

# 生产认证邮件回调的固定公开地址，例如 https://paddock.example。
PADDOCK_SITE_URL=

# Supabase Auth（注册、登录、会话）。在 Supabase Dashboard > Connect 中获取。
# 只使用 publishable key；不要把 secret / service_role key 放到浏览器或此文件中。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 仅用于服务端删除 Auth 用户。必须作为 Cloudflare secret 配置，绝不能使用 NEXT_PUBLIC_ 前缀。
SUPABASE_SERVICE_ROLE_KEY=

# 上线前填写真实、长期可用的隐私/版权联系邮箱。
PADDOCK_LEGAL_CONTACT_EMAIL=
